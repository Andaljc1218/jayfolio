      "eslint --fix",
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andaljc1218/jayfolio.git"
  },
  "keywords": [
    "portfolio",
