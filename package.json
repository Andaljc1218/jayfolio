{
  "name": "jayfolio-v2",
  "version": "2.0.0",
  "description": "JayFolio v2 — Minimal portfolio built with Next.js, TypeScript, and Tailwind CSS",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
