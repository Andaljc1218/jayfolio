    "typescript",
    "tailwindcss"
  ],
  "author": "Jaycee Andal",
  "license": "ISC",
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@vercel/og": "^0.11.1",
    "autoprefixer": "^10.5.4",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "next": "^15.5.22",
    "next-mdx-remote": "^6.0.0",
    "postcss": "^8.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.12",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6"
  }
